# track.site environment template. Copy to .env and fill in local values. Never commit real secrets.
# Generate keys: pnpm --filter @track-site/core keys:generate

# ---- general ----
NODE_ENV=development
APP_ENV=development                # development | staging | production
LOG_LEVEL=info
DATA_REGION=eu                     # eu only for now

# ---- hosts (no trailing slash) ----
HOST_MARKETING=http://localhost:3000
HOST_APP=http://localhost:3000/app
HOST_API=http://localhost:3000/api
HOST_CDN=http://localhost:3000/cdn
HOST_INGEST=http://localhost:3100
NEXT_PUBLIC_HOST_CDN=http://localhost:3000/cdn
NEXT_PUBLIC_HOST_INGEST=http://localhost:3100

# ---- database ----
DATABASE_URL=postgresql://postgres:localdev@127.0.0.1:54330/tracksite_dev
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=postgresql://postgres:localdev@127.0.0.1:54330/tracksite_test
DB_APP_ROLE=tracksite_app

# ---- secrets / keys ----
AUTH_SECRET=                       # 32+ random bytes, base64
MASTER_KEY=                        # 32 random bytes, base64 (envelope encryption root key, KMS_DRIVER=local)
MASTER_KEY_ID=local-v1
KMS_DRIVER=local                   # local | aws
AWS_KMS_KEY_ID=
CONFIG_SIGNING_PRIVATE_KEY=        # Ed25519 private key, base64 (PKCS8)
CONFIG_SIGNING_PUBLIC_KEY=         # Ed25519 public key, base64 (SPKI)
CONFIG_SIGNING_KEY_ID=cfg-v1
APPROVAL_TOKEN_SECRET=             # 32 random bytes, base64

# ---- queue / event store / object store ----
QUEUE_DRIVER=pg                    # pg | sqs | memory
SQS_QUEUE_URL_PREFIX=              # https://sqs.eu-central-1.amazonaws.com/<account>/tracksite-
AWS_REGION=eu-central-1
EVENT_STORE_DRIVER=pg              # pg | clickhouse
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
OBJECT_STORE_DRIVER=fs             # fs | s3
OBJECT_STORE_PATH=.local/objects
S3_BUCKET=
REDIS_URL=

# ---- collector ----
COLLECTOR_PORT=3100
COLLECTOR_MAX_BODY_BYTES=65536
COLLECTOR_MAX_EVENTS_PER_BATCH=50
KILL_SWITCH_GLOBAL=false

# ---- email ----
MAIL_FROM="track.site <no-reply@track.site>"
SMTP_URL=                          # smtp://user:pass@host:587 or leave empty to use RESEND_API_KEY
RESEND_API_KEY=
CONTACT_INBOX_EMAIL=

# ---- AI (OpenAI Responses API) ----
OPENAI_API_KEY=
AI_MODEL_PRIMARY=gpt-5.6-terra
AI_MODEL_FAST=gpt-5.6-luna
AI_MODEL_COMPLEX=gpt-5.6-sol
AI_MAX_TOOL_CALLS_PER_TURN=8
AI_TURN_TIMEOUT_MS=45000
AI_ENABLED=true

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# each STRIPE_PRICE_* value is a Stripe price id (price_…) or a product id (prod_…) with exactly one active recurring price for that interval;
# the Stripe amount must equal the list price of the tariff catalogue (packages/catalog): /api/health reports amount_mismatch otherwise
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
# deprecated (the third plan is "Pro"): still read as a fallback for STRIPE_PRICE_PRO_* and reported by /api/health
# STRIPE_PRICE_SCALE_MONTHLY=
# STRIPE_PRICE_SCALE_YEARLY=

# ---- vendor APIs (platform level) ----
META_GRAPH_API_VERSION=v25.0
TIKTOK_API_VERSION=v1.3
REDDIT_API_VERSION=v3
LINKEDIN_API_VERSION=202508
GOOGLE_ADS_API_VERSION=v21
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
VENDOR_MOCK_BASE_URL=              # tests only: points all connectors at mock vendor servers

# ---- shop integrations ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ---- SEO / verification (never invent) ----
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=track-site

# ---- seeds ----
SEED_DEMO=true

# Vendor platform credentials (operator-level, never tenant-visible; leave empty when a connector is not offered)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional endpoint overrides / API version pins
QUORA_CAPI_ENDPOINT=
GOOGLE_ADS_API_VERSION=v25
LINKEDIN_API_VERSION=202608
TIKTOK_API_VERSION=v1.3
REDDIT_API_VERSION=v3
X_ADS_API_VERSION=12
CM360_API_VERSION=v5
WORKER_PORT=3199                   # local health endpoint of the worker (orchestrators only)

# ---- Track Operations console (/ops) ----
# Platform pages require two-factor authentication for the operator (step-up). false is a local-development
# convenience only: production always requires two-factor regardless of this value. Grant the first admin with
# pnpm --filter @track-site/db ops:grant --email <address> --role PLATFORM_ADMIN
OPS_REQUIRE_2FA=false

# ---- Support desk (/ops/support, docs/18-support-desk.md) ----
# Signing secret of the Resend webhook for inbound e-mail ("email.received", Svix headers svix-id / svix-timestamp /
# svix-signature; value starts with whsec_). Empty = inbound e-mail is refused with 503 until configured.
RESEND_WEBHOOK_SECRET=
# Optional: secret of a second Resend webhook that posts only the delivery events (email.delivered / bounced / ...)
# to /api/support/delivery. Empty = that route accepts RESEND_WEBHOOK_SECRET (one webhook for everything is the default).
RESEND_DELIVERY_WEBHOOK_SECRET=
# Domain that receives replies (Reply-To "support+t<number>@<domain>"); needs the MX record of Resend Inbound.
# Empty = the support_settings row applies (placeholder support.track.site until DNS is set up).
SUPPORT_INBOUND_DOMAIN=
# Sender address of ticket mails (the Resend/SMTP domain must be verified for it). Empty = support_settings row.
SUPPORT_FROM_ADDRESS=
# authserv-id(s) of Resend's receiving MTA whose Authentication-Results header the desk believes (comma-separated). Read the
# value off the "created" event of a first test mail (docs/18-support-desk.md section 5 step 3) - it is never guessed.
# Empty = every inbound mail counts as unauthenticated (fail closed): plus-address / subject replies are refused, known
# members are not linked to their organisation and get no acknowledgement, the DMARC spam rule is off.
SUPPORT_AUTHSERV_ID=
# Worker (Fly app track-site-worker, job "support-sla" — docs/18-support-desk.md section "Integration"): SLA warning /
# breach e-mails to agents use the worker's own mail transport, so the worker needs the same SMTP_URL or RESEND_API_KEY
# plus MAIL_FROM, and HOST_APP for the ticket links in those mails (same values as above; set them as Fly secrets).
