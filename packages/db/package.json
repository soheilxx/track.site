{
  "name": "@track-site/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts --passWithNoTests",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/cli/migrate.ts",
    "migrate:check": "drizzle-kit check && tsx src/cli/migrate-check.ts",
    "seed": "tsx src/cli/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@track-site/core": "workspace:*",
    "@track-site/events": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.5.4",
    "better-auth": "^1.7.2",
    "@track-site/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  }
}
